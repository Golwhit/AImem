{
  "name": "desktop-to-phone-push-poc",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "version:check": "node scripts/check-version.mjs",
    "test:version": "node --test scripts/check-version.test.mjs",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "prebuild": "npm run version:check",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^5.4.14"
  }
}
